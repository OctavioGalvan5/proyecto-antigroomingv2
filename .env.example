# ==============================================================================
# Antigrooming — variables de entorno
# ==============================================================================
# Copiar a `.env` y completar con credenciales REALES.
# NO commitear `.env`. Ver .gitignore.
# ADR-0005: usar credenciales DEDICADAS, no las del CRM.
# ==============================================================================

# ---- Flask ----
# Clave secreta para sesiones. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Entorno: development | production
FLASK_ENV=development
PORT=5000

# URL pública donde Evolution API puede alcanzar nuestro webhook.
# En dev: usar ngrok o cloudflared. Ej: https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=

# ---- Base de datos ----
# Postgres URI. Ej: postgresql://user:pass@host:5432/antigrooming
# ADR-0005: base DEDICADA, no la del CRM.
DATABASE_URL=

# ---- Evolution API ----
# Instalación DEDICADA para este proyecto (o al menos API key separada).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ---- OpenAI (v0.2 en adelante) ----
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-5-mini
OPENAI_MODEL_DEEP=gpt-5

# ---- SMTP (v0.2 en adelante) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@antigrooming.local
SMTP_USE_TLS=true

# ---- Configuración operativa ----
# Días que se retienen los mensajes con `body` en claro antes de purgar.
MESSAGE_RETENTION_DAYS=30

# Umbrales de disparo de análisis
ANALYZE_EVERY_N_MESSAGES=5
ANALYZE_MIN_INTERVAL_MINUTES=10
